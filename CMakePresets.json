{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clion-mingw",
      "displayName": "CLion / MinGW Debug (no Visual Studio)",
      "description": "Use Qt 6.8.3 MinGW 13.1 toolchain + mingw_64 Qt. Ninja from CLion Nova bundled tools.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/Qt6/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt6/Tools/mingw1310_64/bin/g++.exe",
        "BREP_QT_ROOT": "C:/Qt6",
        "CMAKE_PREFIX_PATH": "C:/Qt6/6.8.3/mingw_64",
        "BREP_BUILD_VIEWER": "ON"
      },
      "environment": {
        "PATH": "$penv{LOCALAPPDATA}/Programs/CLion Nova/bin/ninja/win/x64;$penv{LOCALAPPDATA}/Programs/CLion/bin/ninja/win/x64;C:/Qt6/Tools/Ninja;C:/Qt6/Tools/mingw1310_64/bin;C:/Qt6/6.8.3/mingw_64/bin;$penv{PATH}"
      }
    },
    {
      "name": "clion-mingw-release",
      "displayName": "CLion / MinGW Release (no Visual Studio)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/Qt6/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt6/Tools/mingw1310_64/bin/g++.exe",
        "BREP_QT_ROOT": "C:/Qt6",
        "CMAKE_PREFIX_PATH": "C:/Qt6/6.8.3/mingw_64",
        "BREP_BUILD_VIEWER": "ON"
      },
      "environment": {
        "PATH": "$penv{LOCALAPPDATA}/Programs/CLion Nova/bin/ninja/win/x64;$penv{LOCALAPPDATA}/Programs/CLion/bin/ninja/win/x64;C:/Qt6/Tools/Ninja;C:/Qt6/Tools/mingw1310_64/bin;C:/Qt6/6.8.3/mingw_64/bin;$penv{PATH}"
      }
    },
    {
      "name": "mingw-makefiles",
      "displayName": "MinGW Makefiles (fallback if Ninja missing)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "C:/Qt6/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_C_COMPILER": "C:/Qt6/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt6/Tools/mingw1310_64/bin/g++.exe",
        "BREP_QT_ROOT": "C:/Qt6",
        "CMAKE_PREFIX_PATH": "C:/Qt6/6.8.3/mingw_64",
        "BREP_BUILD_VIEWER": "ON"
      },
      "environment": {
        "PATH": "C:/Qt6/Tools/mingw1310_64/bin;C:/Qt6/6.8.3/mingw_64/bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clion-mingw",
      "configurePreset": "clion-mingw"
    },
    {
      "name": "clion-mingw-release",
      "configurePreset": "clion-mingw-release"
    },
    {
      "name": "mingw-makefiles",
      "configurePreset": "mingw-makefiles"
    }
  ]
}
